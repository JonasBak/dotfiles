#!/bin/bash
set -e
export PASSWORD_STORE_DIR=$HOME/.password-store
FILE=$(pass git ls-files | grep -E '^(own/email|own/services|own/homelab|own/totp|work/).*\.gpg' | sed 's/.gpg$//g' | fzf)
if [[ -z "$FILE" ]]; then
  exit 1
fi
COMMAND="pass -c"
if [[ "$FILE" =~ ^own/totp/.* ]]; then
  COMMAND="pass otp -c"
fi
PASSWORD=$($COMMAND "$FILE")
